# ---------------------------------------------------------------
# 1. DATABASE  (the only thing you must paste in yourself)
# ---------------------------------------------------------------
# MongoDB Atlas -> Database -> Connect -> Drivers -> copy the string
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="docseva"

# ---------------------------------------------------------------
# 2. ADMIN PANEL
# ---------------------------------------------------------------
# Used once by `npm run seed` to create the first login.
ADMIN_NAME="Owner"
ADMIN_EMAIL="admin@docseva.in"
ADMIN_PASSWORD="ChangeMe@123"

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------
# 3. SITE
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://docseva.in"
